diff --git a/auditoria/p2-20261024-01/backup-p1/css/style.css b/css/style.css
index 66eac5f..5bf35bf 100644
--- a/auditoria/p2-20261024-01/backup-p1/css/style.css
+++ b/css/style.css
@@ -296,3 +296,66 @@ body.menu-open{overflow:hidden}
  .header nav>a:not(.nav-shop){font-size:25px;line-height:1.1;padding:8px 0;min-height:44px}
  .header nav>a.nav-shop{margin-top:8px;padding:12px 20px;min-height:44px}
 }
+
+/* P2 — Local depth, short sensory gestures, and quiet resting states. */
+.hero-product{perspective:900px;transition:none}
+.hero-product .hero-slide{transform-origin:50% 65%;backface-visibility:hidden;will-change:auto}
+.hero-product.is-transitioning .hero-slide{will-change:transform,opacity}
+.hero-product .hero-slide.is-display{transform-origin:50% 70%}
+.hero-backword,.flavor-seal{transition:color .45s,background .45s}
+.vibe-art{perspective:850px;isolation:isolate}
+.vibe-art>img{z-index:2;backface-visibility:hidden}
+.vibe-art>.motion-ghost{z-index:3;pointer-events:none;grid-area:auto}
+.classic-picture>.motion-ghost{z-index:3;pointer-events:none}
+.classic-picture>img{backface-visibility:hidden;transform-origin:50% 65%}
+.classic-picture{perspective:1000px}
+.vibe-panel:before{display:none}
+.vibe-art:after{content:'';position:absolute;inset:0;border-radius:inherit;background:linear-gradient(115deg,transparent 20%,#ffffff80 48%,transparent 75%);opacity:0;pointer-events:none;z-index:1}
+.vibe-panel[data-motion=azedo] .vibe-art{transition-duration:.24s}
+.vibe-panel[data-motion=doce] .vibe-art{transition-duration:.62s}
+.vibe-panel[data-motion=tubes] .vibe-art{transition-duration:.42s}
+.vibe-panel[data-motion=classicos] .vibe-art{transition-duration:.35s}
+.vibe-panel[data-motion=azedo] .is-reacting:after{animation:sour-prickle .46s ease-out}
+.vibe-panel[data-motion=doce] .is-reacting:after{animation:sweet-bloom .64s ease-in-out}
+.vibe-panel[data-motion=tubes] .is-reacting:after{animation:tube-pass .54s cubic-bezier(.42,0,.2,1)}
+.vibe-panel[data-motion=classicos] .is-reacting:after{animation:classic-press .42s ease-out}
+@keyframes sour-prickle{0%,100%{opacity:0}20%,48%{opacity:.3}34%,65%{opacity:.05}}
+@keyframes sweet-bloom{0%{opacity:0;transform:scale(.85)}55%{opacity:.4}100%{opacity:0;transform:scale(1)}}
+@keyframes tube-pass{0%{opacity:0;transform:translateX(-30%)}40%{opacity:.5}100%{opacity:0;transform:translateX(30%)}}
+@keyframes classic-press{0%{opacity:0;transform:scaleY(.9)}40%{opacity:.25}100%{opacity:0;transform:scaleY(1)}}
+.depth-layer{will-change:auto}
+.world.is-in-view .depth-layer{will-change:transform}
+.world-text.depth-layer{will-change:auto}
+.button{transition:transform .22s cubic-bezier(.2,.7,.3,1),box-shadow .22s}
+.button:hover,.button:focus-visible{transform:translateY(-2px);box-shadow:0 5px 0 #29207418}
+.button:active{transform:translateY(1px) scale(.98);box-shadow:none;transition-duration:.1s}
+.button:focus-visible span,.text-link:focus-visible span{transform:translate(2px,-2px)}
+.vibe-tabs button{transition:color .16s,transform .16s}
+.vibe-tabs button:hover{transform:translateY(-1px)}
+.vibe-tabs button:active{transform:translateY(1px)}
+.vibe-tabs button[aria-selected=true]:after{transform-origin:left;animation:tab-mark .22s ease-out}
+@keyframes tab-mark{from{transform:scaleX(.4)}to{transform:scaleX(1)}}
+.slider-controls button{transition:transform .18s,background .18s,color .18s}
+.slider-controls button:hover{transform:scale(1.04)}
+.slider-controls button:active{transform:scale(.94)}
+.js .vibes .reveal>div{transition-duration:.65s}
+.js .classics .reveal h2{transition-duration:.65s}
+.js .world-text.reveal h2{transition-duration:.8s}
+.js .about-copy.reveal>h2{transition-duration:.65s;transition-delay:.1s}
+.js .about-copy.reveal>p,.js .about-copy.reveal .about-facts{transition-duration:.65s;transition-delay:.22s}
+.js .about-art.reveal img{transition-duration:.7s,.85s;transition-delay:.12s}
+.final-lineup img{transition-duration:.8s,.5s}
+.ticker.motion-rest>div{animation-play-state:paused}
+.motion-suspended *,.motion-suspended *:before,.motion-suspended *:after{animation-play-state:paused!important}
+@media(max-width:767px){
+ .hero-product{perspective:750px}
+ .header nav>a:not(.nav-shop){transition-duration:.32s}
+ .header nav>a:nth-child(2){transition-delay:30ms}.header nav>a:nth-child(3){transition-delay:60ms}.header nav>a:nth-child(4){transition-delay:90ms}
+ .world.is-in-view .depth-layer{will-change:auto}
+}
+@media(prefers-reduced-motion:reduce){
+ .hero-product,.vibe-art,.classic-picture{perspective:none}
+ .hero-product.is-transitioning .hero-slide,.world.is-in-view .depth-layer{will-change:auto}
+ .vibe-art:after{display:none}
+ .button:hover,.button:focus-visible,.vibe-tabs button:hover,.slider-controls button:hover{transform:none}
+}
